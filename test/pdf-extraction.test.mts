/**
 * Abstract-extraction tests. Run with `npm run test:pdf`.
 *
 * Fixtures are generated by test/fixtures/build-pdfs.mts; run
 * `npm run test:fixtures` first (or `npm test`, which chains both).
 */
import { describe, it, before } from "node:test";
import assert from "node:assert/strict";
import { readFileSync, existsSync } from "node:fs";
import { dirname, join } from "node:path";
import { fileURLToPath } from "node:url";

import {
  extractAbstract,
  cleanAbstractText,
  looksLikePdf,
  type AbstractResult,
} from "../lib/pdf/extract.ts";

const FIXTURES = join(dirname(fileURLToPath(import.meta.url)), "fixtures", "pdfs");

function load(name: string): Uint8Array {
  const path = join(FIXTURES, name);
  if (!existsSync(path)) {
    throw new Error(
      `Missing fixture ${name}. Run: npm run test:fixtures`,
    );
  }
  return new Uint8Array(readFileSync(path));
}

const run = (name: string) => extractAbstract(load(name));

function expectOk(
  result: Awaited<ReturnType<typeof extractAbstract>>,
): asserts result is AbstractResult {
  assert.equal(
    result.ok,
    true,
    `expected extraction to succeed, got: ${"reason" in result ? result.reason : "?"}`,
  );
}

describe("abstract extraction", () => {
  before(() => {
    if (!existsSync(FIXTURES)) {
      throw new Error("Fixtures not built. Run: npm run test:fixtures");
    }
  });

  it("reads a standalone ABSTRACT heading with high confidence", async () => {
    const result = await run("standard.pdf");
    expectOk(result);

    assert.equal(result.confidence, "high");
    assert.match(result.abstract, /^This study examines the relationship/);
    assert.ok(result.abstract.length > 400, "captured the full abstract");
  });

  it("stops at the KEYWORDS terminator and parses the keywords", async () => {
    const result = await run("standard.pdf");
    expectOk(result);

    assert.doesNotMatch(result.abstract, /KEYWORDS/i);
    assert.deepEqual(result.keywords, [
      "adaptive learning",
      "academic performance",
      "mixed methods",
    ]);
  });

  it("never bleeds into Chapter 1", async () => {
    for (const fixture of ["standard.pdf", "no-keywords.pdf"]) {
      const result = await run(fixture);
      expectOk(result);
      assert.doesNotMatch(result.abstract, /CHAPTER 1/i, fixture);
      assert.doesNotMatch(result.abstract, /INTRODUCTION/i, fixture);
      assert.doesNotMatch(result.abstract, /must not be captured/i, fixture);
    }
  });

  it("handles the inline `Abstract:` heading form", async () => {
    const result = await run("inline-heading.pdf");
    expectOk(result);

    assert.equal(result.confidence, "high");
    assert.match(result.abstract, /^This study examines/);
    assert.doesNotMatch(result.abstract, /^Abstract/i);
  });

  it("finds an abstract behind a title page and approval sheet", async () => {
    const result = await run("front-matter.pdf");
    expectOk(result);

    assert.equal(result.confidence, "high");
    assert.match(result.abstract, /adaptive learning platforms/);
    assert.doesNotMatch(result.abstract, /APPROVAL SHEET/i);
  });

  it("falls back to prose at low confidence when the heading is unrecognizable", async () => {
    const result = await run("letterspaced-heading.pdf");
    expectOk(result);

    assert.equal(
      result.confidence,
      "low",
      "a guessed abstract must be flagged for the reviewer",
    );
    assert.match(result.abstract, /adaptive learning platforms/);
  });

  it("rejects a scanned, image-only PDF", async () => {
    const result = await run("scanned.pdf");

    assert.equal(result.ok, false);
    assert.equal(result.ok === false && result.reason, "no-text-layer");
    assert.match(
      result.ok === false ? result.message : "",
      /scanned image/i,
      "message tells the student what to do",
    );
  });

  it("rejects a PDF with no abstract at all", async () => {
    const result = await run("no-abstract.pdf");

    assert.equal(result.ok, false);
    assert.equal(result.ok === false && result.reason, "no-abstract-found");
  });

  it("rejects a stub under an ABSTRACT heading", async () => {
    const result = await run("truncated.pdf");

    assert.equal(result.ok, false);
    assert.equal(result.ok === false && result.reason, "abstract-too-short");
  });
});

describe("cleanAbstractText", () => {
  it("rejoins words hyphenated across a line break", () => {
    const out = cleanAbstractText(["a mixed-meth-", "ods design was used"]);
    assert.equal(out, "a mixed-methods design was used");
  });

  it("drops bare page numbers and running folios", () => {
    const out = cleanAbstractText([
      "the first half of the sentence",
      "  iv  ",
      "12",
      "Page 3 of 90",
      "and the second half",
    ]);
    assert.equal(out, "the first half of the sentence and the second half");
  });

  it("collapses whitespace", () => {
    assert.equal(cleanAbstractText(["one   two", "", "  three "]), "one two three");
  });
});

describe("looksLikePdf", () => {
  it("accepts the %PDF- magic bytes", () => {
    assert.equal(looksLikePdf(new TextEncoder().encode("%PDF-1.7\n...")), true);
  });

  it("rejects anything else, whatever its MIME type claims", () => {
    assert.equal(looksLikePdf(new TextEncoder().encode("<html></html>")), false);
    assert.equal(looksLikePdf(new Uint8Array([0x25, 0x50])), false);
    assert.equal(looksLikePdf(new Uint8Array(0)), false);
  });
});
