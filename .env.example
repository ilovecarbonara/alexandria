# ── Supabase ──────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=          # Supabase → Project Settings → API → Project URL
NEXT_PUBLIC_SUPABASE_ANON_KEY=     # Supabase → Project Settings → API → anon/public key
SUPABASE_SERVICE_ROLE_KEY=         # Supabase → Project Settings → API → service_role key (keep secret)

# ── Blockchain (Alchemy + Sepolia) ───────────────────────
ALCHEMY_API_KEY=                   # Alchemy dashboard → Create App (Sepolia) → API Key
DEPLOYER_PRIVATE_KEY=              # Sepolia wallet private key (without 0x prefix)
CONTRACT_ADDRESS=                  # Deployed ThesisRegistry contract address (filled after deploy)

# ── Similarity Detection ─────────────────────────────────
TITLE_ALERT_THRESHOLD=0.50         # Similarity score to trigger title alerts (0–1)
AUTO_FLAG_THRESHOLD=0.75           # Auto-flag threshold — theses at or above this score are auto-flagged

# ── Application ──────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000   # Deployed URL (e.g. https://your-app.vercel.app)
